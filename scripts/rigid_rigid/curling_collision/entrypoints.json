    "scene_config.py",
    "simulate_curling_collision.py",
    "physics/validate_curling_collision.py",
    "appearance/look_curling_collision.py",
    "render_curling_collision.py",
    "build_pcve_curling_collision.py",
    "asset_manifest.json",
    "tools/prepare_sketchfab_asset.py",
    "edit_vocab.py"
  ]
